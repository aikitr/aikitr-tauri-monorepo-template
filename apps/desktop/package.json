{
  "name": "@aikitr/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aikitr Tauri 2 + Vue 3 desktop application.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,md,json}\""
  },
  "dependencies": {
    "@aikitr/hooks": "workspace:*",
    "@aikitr/types": "workspace:*",
    "@aikitr/ui": "workspace:*",
    "@aikitr/utils": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-log": "^2.0.1",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-sql": "^2.0.1",
    "@tauri-apps/plugin-store": "^2.1.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.1",
    "@tauri-apps/plugin-http": "^2.0.1",
    "ofetch": "^1.4.0",
    "pinia": "^2.2.4",
    "reka-ui": "^1.0.0-alpha.10",
    "vue": "^3.5.0",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@tailwindcss/vite": "^4.0.0-beta.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0-beta.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
