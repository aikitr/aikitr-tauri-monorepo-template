{
  "name": "@aikitr/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Aikitr pure-function utilities shared across apps.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "import": "./src/logger/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    },
    "./date": {
      "types": "./src/date/index.ts",
      "import": "./src/date/index.ts"
    },
    "./result": {
      "types": "./src/result/index.ts",
      "import": "./src/result/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^6.2.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "ofetch": "^1.4.0"
  }
}
