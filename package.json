{
  "name": "aikitr",
  "version": "0.1.0",
  "private": true,
  "description": "Aikitr monorepo — enterprise Tauri 2 + Vue 3 desktop application template.",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r --filter=\"./packages/*\" run build && pnpm --filter=@aikitr/desktop run build",
    "dev:desktop": "pnpm --filter=@aikitr/desktop run dev",
    "build:desktop": "pnpm --filter=@aikitr/desktop run tauri:build",
    "clean": "pnpm -r exec rimraf dist node_modules .turbo .cache"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
