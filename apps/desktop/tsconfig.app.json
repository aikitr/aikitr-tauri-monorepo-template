{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["src/*"],
      "@aikitr/ui": ["../../packages/ui/src/index.ts"],
      "@aikitr/ui/*": ["../../packages/ui/src/*"],
      "@aikitr/hooks": ["../../packages/hooks/src/index.ts"],
      "@aikitr/types": ["../../packages/types/src/index.ts"],
      "@aikitr/utils": ["../../packages/utils/src/index.ts"],
      "@aikitr/utils/*": ["../../packages/utils/src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/ui/src/**/*.vue",
    "../../packages/ui/src/**/*.ts",
    "../../packages/hooks/src/**/*.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/utils/src/**/*.ts"
  ],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts", "dist", "node_modules"]
}
