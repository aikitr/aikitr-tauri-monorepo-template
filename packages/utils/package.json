{
  "name": "@aikitr/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Aikitr pure-function utilities shared across apps.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "import": "./src/logger/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    },
    "./date": {
      "types": "./src/date/index.ts",
      "import": "./src/date/index.ts"
    },
    "./result": {
      "types": "./src/result/index.ts",
      "import": "./src/result/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ofetch": "^1.4.0"
  }
}
